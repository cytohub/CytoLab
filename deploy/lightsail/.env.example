# Copy to .env in this folder and fill in. Keep the filled-in file only on the
# server; it holds the database passwords.

# Your domain, without https://. www.<domain> redirects to it.
DOMAIN=cytolab.ai

# Generate each with: openssl rand -hex 24
# (hex keeps them safe inside connection URLs). They take effect when the
# database is first created; changing them later needs a manual role update.
POSTGRES_PASSWORD=
APP_DB_PASSWORD=

# Public demo switches (see DEPLOY.md). Keep both true for the public demo.
DEMO_MODE=true
PUBLIC_DEMO=true
