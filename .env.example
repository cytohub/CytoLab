# PostgreSQL connection (docker compose up -d starts one on localhost:5432)
DATABASE_URL=postgres://cytolab:cytolab@localhost:5432/cytolab
# Production: connect the app as a role that can only read and write rows, and
# run migrations and resets as the owner. Both default to DATABASE_URL.
# MIGRATION_DATABASE_URL=postgres://owner:…@host:5432/db
# APP_DB_ROLE=cytolab_app
# Separate database used by integration tests (it is wiped on each run)
DATABASE_URL_TEST=postgres://cytolab:cytolab@localhost:5432/cytolab_test

# Canonical public URL of the app (e.g. https://cytolab.ai). Writes from this origin are
# always accepted, and in production requests for www.<host> redirect here.
APP_URL=http://localhost:3000

# Enables one-click demo accounts on the sign-in page. In production mode (pnpm start,
# Docker) demo workspaces open only when PUBLIC_DEMO=true as well.
DEMO_MODE=true

# Public demo: anyone can sign in to the shared synthetic workspace. Locks uploads and
# account changes, rate-limits writes per visitor, and lets db:seed / db:reset run in
# production (for the nightly reset) as long as the database holds only demo workspaces.
PUBLIC_DEMO=false

# Header your reverse proxy overwrites with the client's IP (Railway: x-real-ip,
# Cloudflare: cf-connecting-ip). Unset uses the last X-Forwarded-For hop, which is
# only as trustworthy as the proxy in front; set it in production.
# CLIENT_IP_HEADER=x-real-ip
# Behind a CDN, a value the CDN adds as the `x-client-ip-secret` request header.
# CLIENT_IP_HEADER is then believed only on requests that carry it, so requests sent
# straight to the origin cannot claim an address. Generate with: openssl rand -hex 32
# CLIENT_IP_SECRET=

# Local attachment storage (V1). Replace with an object-store provider in production.
STORAGE_DIR=.data/uploads
MAX_UPLOAD_BYTES=26214400
# Total attachment storage per organization (deleted files count; they stay on disk). Default 10 GiB.
# MAX_ORG_STORAGE_BYTES=10737418240

# Shared secret for internal job endpoints (e.g. POST /api/v1/internal/jobs/attention-scan).
# Unset disables them. Generate with: openssl rand -hex 32
# INTERNAL_JOB_SECRET=

# debug | info | warn | error
LOG_LEVEL=info
